# Morning Digest configuration — copy to .env and adjust.
# The default setup (Ollama + Gemma 3) needs NO API key and works fully offline.

# --- Ollama (local open-weight models) — used with --provider ollama (default) ---
# Default model is Gemma 3 (open-weight). Change to any model you pulled with
# Ollama, e.g. gemma3:1b for a quick test, llama3.2, qwen2.5, mistral
OLLAMA_MODEL=gemma3

# Ollama server address (default is your local machine)
# OLLAMA_BASE_URL="http://localhost:11434"

# --- OpenAI (optional hosted provider) — only needed with --provider openai ---
# OPENAI_API_KEY=<your key here>
# OPENAI_BASE_URL="https://api.openai.com/v1"
